{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "resolveJsonModule": true, "outDir": "dist", "declaration": true,
    "skipLibCheck": true, "sourceMap": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "examples/**/*.ts", "playwright.config.ts"]
}
